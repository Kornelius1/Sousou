#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn resolves_media_by_filename() {
        let root = std::env::temp_dir().join("pc_resolve_test");
        let _ = std::fs::remove_dir_all(&root);
        std::fs::create_dir_all(root.join("Media")).unwrap();
        std::fs::write(root.join("Media/clip.mov"), b"x").unwrap();

        let (p, ok) = resolve_media(&root, "Media/Assets/CLIP.mov");
        assert!(ok);
        assert!(p.ends_with("Media/clip.mov") || p.ends_with("Media\\clip.mov"));

        let (_, missing) = resolve_media(&root, "Media/Assets/none.mov");
        assert!(!missing);
    }

    #[test]
    fn header_only_is_empty() {
        let rtf = br"{\rtf0\ansi\ansicpg1252{\fonttbl\f0\fnil ArialMT;}{\colortbl;\red0\green0\blue0;}{\*\expandedcolortbl;\csgenericrgb\c0\c0\c0\c100000;}{\*\listtable}{\*\listoverridetable}\uc1\paperw12240\margl0\pard\li0\ql\f0\fs100\cf1\cb3}";
        assert_eq!(rtf_to_text(rtf), "");
    }

    #[test]
    fn hex_escape_and_par() {
        let rtf = br"{\rtf0\ansi{\fonttbl\f0 Arial;}\f0\fs100 Caf\'e9 pagi\par Baris dua}";
        assert_eq!(rtf_to_text(rtf), "Café pagi\nBaris dua");
    }

    #[test]
    fn backslash_newline_is_line_break() {
        assert_eq!(rtf_to_text(b"{\\rtf0 Satu\\\nDua}"), "Satu\nDua");
    }

    #[test]
    fn unicode_with_fallback() {
        assert_eq!(rtf_to_text(b"{\\rtf0\\uc1 a\\u225?b}"), "aáb");
        assert_eq!(rtf_to_text(b"{\\rtf0\\uc2 a\\u233\\'e9\\'e9b}"), "aéb");
    }

    #[test]
    fn unicode_surrogate_pair() {
        // U+1F600 = D83D DE00 → -10179 -8704
        assert_eq!(rtf_to_text(b"{\\rtf0\\uc1 \\u-10179?\\u-8704?}"), "😀");
    }

    #[test]
    fn rejects_unsafe_paths() {
        assert!(safe_relative("Media/Assets/a.mov"));
        assert!(!safe_relative("../x.mov"));
        assert!(!safe_relative("/etc/passwd"));
    }

    /// Menguji invarian umum untuk setiap *.pro di tests/fixtures/,
    /// tanpa mengandalkan isi satu file tertentu.
    #[test]
    fn fixtures_invariants() {
        let dir = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures");
        let Ok(rd) = std::fs::read_dir(&dir) else { return };
        for e in rd.flatten() {
            let p = e.path();
            if p.extension().and_then(|x| x.to_str()) != Some("pro") {
                continue;
            }
            let r = parse_pro_file(&p, &dir).unwrap_or_else(|err| panic!("{p:?}: {err}"));
            for (i, s) in r.slides.iter().enumerate() {
                assert_eq!(s.slide_number, i + 1, "{p:?}");
                for l in &s.layers {
                    assert!(l.rect.w > 0.0 && l.rect.h > 0.0, "{p:?}: rect tak valid");
                    assert!(l.rect.x.is_finite() && l.rect.y.is_finite());
                    match l.kind.as_str() {
                        "video" | "image" => assert!(l.path.is_some(), "{p:?}"),
                        "color" => assert!(l.color.is_some(), "{p:?}"),
                        "text" => assert!(l.text.is_some(), "{p:?}"),
                        k => panic!("{p:?}: kind tak dikenal {k}"),
                    }
                    if l.kind != "video" {
                        assert!(l.muted.is_none() && l.looped.is_none());
                    }
                }
            }
        }
    }
