/// Lowercase, letters and digits only: "1 Kor." -> "1kor".
fn norm(s: &str) -> String {
    s.chars()
        .filter(|c| c.is_alphanumeric())
        .flat_map(|c| c.to_lowercase())
        .collect()
}

fn book_keys(b: &BookDef) -> Vec<String> {
    [b.id, b.id_name, b.en_name]
        .into_iter()
        .chain(b.abbr.iter().copied())
        .map(norm)
        .collect()
}

fn book_index() -> &'static HashMap<String, usize> {
    static MAP: OnceLock<HashMap<String, usize>> = OnceLock::new();
    MAP.get_or_init(|| {
        let mut m = HashMap::new();
        for (i, b) in BOOKS.iter().enumerate() {
            for k in book_keys(b) {
                m.entry(k).or_insert(i);
            }
        }
        m
    })
}

fn book_by_id(id: &str) -> Option<usize> {
    BOOKS.iter().position(|b| b.id == id)
}

fn book_name(def: &BookDef, lang: &str) -> &'static str {
    let l = lang.to_lowercase();
    if l == "id" || l.starts_with("ind") || l.starts_with("id-") {
        def.id_name
    } else {
        def.en_name
    }
}

// ---------------------------------------------------------------- USFM

pub struct ParsedBook {
    pub code: String,
    pub chapters: Vec<Vec<String>>,
}

// Markers whose text is not scripture (titles, headings, intro material, alternate numbering).
const SKIP: &[&str] = &[
    "ide", "usfm", "h", "toc", "mt", "mte", "imt", "ms", "mr", "s", "sr", "r", "rq", "sp", "cl", "cd",
    "rem", "sts", "periph", "lit", "va", "vp", "ca", "cp", "qa", "is", "ip", "ib", "io", "iot", "imi",
    "ili", "ipi", "ie", "im", "imq", "ipq", "ipr", "iq", "iex", "ior",
];

fn put(chapters: &mut [Vec<String>], ch: usize, vs: usize, s: &str) {
    if ch == 0 || vs == 0 || ch > chapters.len() {
        return;
    }
    let c = &mut chapters[ch - 1];
    if c.len() < vs {
        c.resize(vs, String::new());
    }
    c[vs - 1].push_str(s);
}

/// Leading number of a chapter/verse marker. Skips a bridge ("3-4") and a part letter ("3a").
/// Returns (number, remaining text without the single separating space).
fn leading_number(s: &str) -> (usize, &str) {
    let s = s.trim_start();
    let end = s.find(|c: char| !c.is_ascii_digit()).unwrap_or(s.len());
    let n = s[..end].parse::<usize>().unwrap_or(0);
    let mut rest = &s[end..];
    if let Some(r) = rest.strip_prefix(['-', '–']) {
        let e = r.find(|c: char| !c.is_ascii_digit()).unwrap_or(r.len());
        if e > 0 {
            rest = &r[e..];
        }
    }
    if let Some(c) = rest.chars().next() {
        if c.is_ascii_alphabetic() && rest[1..].starts_with(char::is_whitespace) {
            rest = &rest[1..];
        }
    }
    (n, rest.strip_prefix(char::is_whitespace).unwrap_or(rest))
}

pub fn parse_usfm(text: &str) -> Option<ParsedBook> {
    let text = text.trim_start_matches('\u{feff}');
    let mut code = String::new();
    let mut chapters: Vec<Vec<String>> = Vec::new();
    let (mut ch, mut vs) = (0usize, 0usize);
    let mut skip = false; // inside a footnote, cross-reference or figure
    let mut preface = String::new(); // \d (psalm title) text, merged into verse 1

    for seg in text.split('\\').skip(1) {
        let end = seg
            .find(|c: char| !(c.is_ascii_alphanumeric() || c == '+'))
            .unwrap_or(seg.len());
        let (name, after) = seg.split_at(end);
        if after.starts_with("-s") || after.starts_with("-e") {
            continue; // USFM 3 milestone: carries attributes, no text
        }
        let closing = after.starts_with('*');
        let mut rest = if closing { &after[1..] } else { after };
        if !closing {
            rest = rest.strip_prefix(char::is_whitespace).unwrap_or(rest);
        }
        let base = name
            .trim_start_matches('+')
            .trim_end_matches(|c: char| c.is_ascii_digit());

        match base {
            "id" => {
                if code.is_empty() {
                    code = rest.trim().chars().take(3).collect::<String>().to_uppercase();
                }
            }
            "c" => {
                skip = false;
                let (n, _) = leading_number(rest);
                ch = if n > 0 { n } else { ch + 1 };
                vs = 0;
                preface.clear();
                if chapters.len() < ch {
                    chapters.resize(ch, Vec::new());
                }
            }
            "v" => {
                skip = false;
                let (n, tail) = leading_number(rest);
                if ch == 0 || n == 0 {
                    continue;
                }
                vs = n;
                if vs == 1 && !preface.is_empty() {
                    let p = std::mem::take(&mut preface);
                    put(&mut chapters, ch, vs, &p);
                }
                put(&mut chapters, ch, vs, tail);
            }
            "f" | "fe" | "ef" | "x" | "ex" | "fig" => skip = !closing,
            _ if skip => {}
            b if SKIP.contains(&b) => {}
            "d" => {
                if vs == 0 {
                    preface.push_str(rest);
                    preface.push(' ');
                }
            }
            "w" | "wg" | "wh" | "wa" => {
                // \w word|attributes\w*: keep the word, drop the attributes
                let t = if closing { rest } else { rest.split('|').next().unwrap_or("") };
                put(&mut chapters, ch, vs, t);
            }
            _ => put(&mut chapters, ch, vs, rest),
        }
    }

    for c in chapters.iter_mut() {
        for v in c.iter_mut() {
            *v = v.split_whitespace().collect::<Vec<_>>().join(" ");
        }
    }
    if code.is_empty() {
        None
    } else {
        Some(ParsedBook { code, chapters })
    }
}

// ---------------------------------------------------------------- import / storage

pub fn import_zip(path: &Path, meta: &Meta) -> Result<Translation, String> {
    safe_id(&meta.id)?;
    let file = fs::File::open(path).map_err(|e| format!("Cannot open file: {e}"))?;
    let mut zip = zip::ZipArchive::new(file).map_err(|e| format!("Not a valid zip file: {e}"))?;
    let mut found: HashMap<usize, Vec<Vec<String>>> = HashMap::new();

    for i in 0..zip.len() {
        let mut f = zip.by_index(i).map_err(|e| e.to_string())?;
        let name = f.name().to_lowercase();
        if !(name.ends_with(".usfm") || name.ends_with(".sfm")) || f.size() > 20_000_000 {
            continue;
        }
        let mut bytes = Vec::new();
        f.read_to_end(&mut bytes).map_err(|e| e.to_string())?;
        if let Some(p) = parse_usfm(&String::from_utf8_lossy(&bytes)) {
            if let Some(idx) = book_by_id(&p.code) {
                found.entry(idx).or_insert(p.chapters);
            }
        }
    }
    if found.is_empty() {
        return Err("No USFM books found in this file.".into());
    }
    let mut order: Vec<usize> = found.keys().copied().collect();
    order.sort_unstable();
    let books = order
        .into_iter()
        .filter_map(|i| {
            found.remove(&i).map(|chapters| Book {
                id: BOOKS[i].id.to_string(),
                chapters,
            })
        })
        .collect();
    Ok(Translation { meta: meta.clone(), books })
}

fn safe_id(id: &str) -> Result<String, String> {
    let ok = !id.is_empty()
        && id.len() <= 40
        && id.chars().all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-');
    if ok {
        Ok(id.to_string())
    } else {
        Err("Invalid translation id.".into())
    }
}

pub fn save(dir: &Path, t: &Translation) -> Result<(), String> {
    let id = safe_id(&t.meta.id)?;
    fs::create_dir_all(dir).map_err(|e| e.to_string())?;
    let tmp = dir.join(format!("{id}.json.tmp"));
    fs::write(&tmp, serde_json::to_vec(t).map_err(|e| e.to_string())?).map_err(|e| e.to_string())?;
    fs::rename(&tmp, dir.join(format!("{id}.json"))).map_err(|e| e.to_string())?;
    let info = Info { meta: t.meta.clone(), books: t.books.len() };
    fs::write(
        dir.join(format!("{id}.meta.json")),
        serde_json::to_vec(&info).map_err(|e| e.to_string())?,
    )
    .map_err(|e| e.to_string())
}

pub fn list(dir: &Path) -> Vec<Info> {
    let mut out: Vec<Info> = fs::read_dir(dir)
        .into_iter()
        .flatten()
        .flatten()
        .filter(|e| e.file_name().to_string_lossy().ends_with(".meta.json"))
        .filter_map(|e| fs::read(e.path()).ok())
        .filter_map(|b| serde_json::from_slice(&b).ok())
        .collect();
    out.sort_by(|a, b| a.meta.name.to_lowercase().cmp(&b.meta.name.to_lowercase()));
    out
}

pub fn remove(dir: &Path, id: &str) -> Result<bool, String> {
    let id = safe_id(id)?;
    let a = fs::remove_file(dir.join(format!("{id}.json"))).is_ok();
    let _ = fs::remove_file(dir.join(format!("{id}.meta.json")));
    Ok(a)
}

pub fn load(dir: &Path, st: &BibleState, id: &str) -> Result<Arc<Translation>, String> {
    let id = safe_id(id)?;
    if let Some(t) = st.cache.lock().map_err(|e| e.to_string())?.get(&id) {
        return Ok(t.clone());
    }
    let bytes = fs::read(dir.join(format!("{id}.json"))).map_err(|_| "Translation is not installed.".to_string())?;
    let t: Arc<Translation> = Arc::new(serde_json::from_slice(&bytes).map_err(|e| e.to_string())?);
    st.cache.lock().map_err(|e| e.to_string())?.insert(id, t.clone());
    Ok(t)
}

// ---------------------------------------------------------------- references / lookup / search

#[derive(Debug, PartialEq, Clone)]
pub struct Ref {
    pub book: usize,
    pub chapter: u32,
    pub from: Option<u32>,
    pub to: Option<u32>,
}

/// "Yoh 3:16-18", "1 Kor 13", "John 3:16", "1Kor13:4", "Mazmur 23".
pub fn parse_ref(input: &str) -> Result<Ref, String> {
    let mut s = input.trim().replace(['–', '—'], "-");
    for (a, b) in [(" :", ":"), (": ", ":"), (" -", "-"), ("- ", "-")] {
        while s.contains(a) {
            s = s.replace(a, b);
        }
    }
    let split = s
        .rfind(|c: char| !(c.is_ascii_digit() || c == ':' || c == '-'))
        .map(|i| i + s[i..].chars().next().map_or(0, char::len_utf8))
        .unwrap_or(0);
    let (book_part, spec) = s.split_at(split);
    if spec.is_empty() || !spec.starts_with(|c: char| c.is_ascii_digit()) {
        return Err("Type a chapter after the book, for example: John 3:16".into());
    }
    let book = *book_index()
        .get(&norm(book_part))
        .ok_or_else(|| format!("Unknown book: {}", book_part.trim()))?;

    let bad = || "Invalid reference. Example: John 3:16-18".to_string();
    let (cpart, vpart) = match spec.split_once(':') {
        Some((c, v)) => (c, Some(v)),
        None => (spec, None),
    };
    let chapter: u32 = cpart.parse().map_err(|_| bad())?;
    if chapter == 0 {
        return Err(bad());
    }
    let (from, to) = match vpart {
        None => (None, None),
        Some(v) => match v.split_once('-') {
            Some((a, b)) => (Some(a.parse().map_err(|_| bad())?), Some(b.parse().map_err(|_| bad())?)),
            None => (Some(v.parse().map_err(|_| bad())?), None),
        },
    };
    Ok(Ref { book, chapter, from, to })
}

#[derive(Serialize, Clone)]
pub struct VerseOut {
    pub n: u32,
    pub text: String,
}

#[derive(Serialize, Clone)]
pub struct Passage {
    pub book_id: String,
    pub book: String,
    pub chapter: u32,
    pub label: String,
    pub verses: Vec<VerseOut>,
    pub translation: String,
    pub license: String,
    pub attribution: String,
}

pub fn passage(t: &Translation, r: &Ref) -> Result<Passage, String> {
    let def = &BOOKS[r.book];
    let name = book_name(def, &t.meta.lang);
    let book = t
        .books
        .iter()
        .find(|b| b.id == def.id)
        .ok_or_else(|| format!("{name} is not in this translation."))?;
    let chap = book
        .chapters
        .get(r.chapter as usize - 1)
        .ok_or_else(|| format!("{name} has no chapter {}.", r.chapter))?;
    let (a, b) = match (r.from, r.to) {
        (None, _) => (1, chap.len() as u32),
        (Some(a), None) => (a, a),
        (Some(a), Some(b)) => (a.min(b), a.max(b)),
    };
    let verses: Vec<VerseOut> = (a..=b)
        .filter_map(|n| {
            let text = chap.get((n as usize).checked_sub(1)?)?;
            (!text.is_empty()).then(|| VerseOut { n, text: text.clone() })
        })
        .collect();
    let (first, last) = match (verses.first(), verses.last()) {
        (Some(f), Some(l)) => (f.n, l.n),
        _ => return Err("No such verse in this translation.".into()),
    };
    let label = if r.from.is_none() {
        format!("{name} {}", r.chapter)
    } else if first == last {
        format!("{name} {}:{first}", r.chapter)
    } else {
        format!("{name} {}:{first}-{last}", r.chapter)
    };
    Ok(Passage {
        book_id: def.id.to_string(),
        book: name.to_string(),
        chapter: r.chapter,
        label,
        verses,
        translation: t.meta.name.clone(),
        license: t.meta.license.clone(),
        attribution: t.meta.attribution.clone(),
    })
}

#[derive(Serialize, Clone)]
pub struct Hit {
    pub book_id: String,
    pub book: String,
    pub chapter: u32,
    pub verse: u32,
    pub text: String,
}

/// Every word must appear (case-insensitive), in canonical book order.
pub fn search(t: &Translation, query: &str, limit: usize) -> Vec<Hit> {
    let words: Vec<String> = query.split_whitespace().map(str::to_lowercase).collect();
    let mut out = Vec::new();
    if words.is_empty() {
        return out;
    }
    for b in &t.books {
        let Some(i) = book_by_id(&b.id) else { continue };
        let name = book_name(&BOOKS[i], &t.meta.lang);
        for (ci, chap) in b.chapters.iter().enumerate() {
            for (vi, text) in chap.iter().enumerate() {
                if text.is_empty() {
                    continue;
                }
                let low = text.to_lowercase();
                if words.iter().all(|w| low.contains(w)) {
                    out.push(Hit {
                        book_id: b.id.clone(),
                        book: name.to_string(),
                        chapter: ci as u32 + 1,
                        verse: vi as u32 + 1,
                        text: text.clone(),
                    });
                    if out.len() >= limit {
                        return out;
                    }
                }
            }
        }
    }
    out
}

